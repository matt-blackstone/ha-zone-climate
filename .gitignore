# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Home Assistant manual sandbox state (YAML sandbox)
config/.storage/
config/.cloud/
config/deps/
config/tts/
config/blueprints/
config/home-assistant_v2.db*
config/home-assistant.log*
config/.HA_VERSION

# Home Assistant manual sandbox state (UI sandbox)
# .storage/ contains hashed credentials and refresh tokens — must
# never be committed.
config-ui/.storage/
config-ui/.cloud/
config-ui/deps/
config-ui/tts/
config-ui/blueprints/
config-ui/home-assistant_v2.db*
config-ui/home-assistant.log*
config-ui/.HA_VERSION
config-ui/.ha_run.lock

# macOS
.DS_Store

# Local credentials generated during agent/developer workflows
.codex-keys/

# Home Assistant e2e test container state
tests/integration/ha_config/.storage/
tests/integration/ha_config/.cloud/
tests/integration/ha_config/deps/
tests/integration/ha_config/tts/
tests/integration/ha_config/blueprints/
tests/integration/ha_config/home-assistant_v2.db*
tests/integration/ha_config/home-assistant.log*
tests/integration/ha_config/.HA_VERSION
tests/integration/ha_config/secrets.yaml
# configuration.yaml is generated from configuration.yaml.template per session
tests/integration/ha_config/configuration.yaml
